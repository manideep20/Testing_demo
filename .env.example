# Required credentials for authenticated mobile flows
MOBILE_TEST_USER=replace-with-test-mobile-number
MOBILE_TEST_PASSWORD=replace-with-test-password
MOBILE_TEST_USER_NAME=replace-with-profile-name

# SMTP server settings used by npm run allure:report
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=replace-with-your-smtp-password
ALLURE_EMAIL_FROM=sender@example.com
ALLURE_EMAIL_TO=recipient@example.com
ALLURE_EMAIL_SUBJECT=Mobilewright Allure test report
