{
  "name": "mobilewight_apxmobile",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/run-mobile-tests.mjs --reporter=line",
    "test:direct": "playwright test --config=mobilewright.config.ts --reporter=line",
    "test:failed": "node scripts/run-mobile-tests.mjs --reporter=line",
    "test:mobilewright": "node scripts/run-mobile-tests.mjs --reporter=line,allure-playwright",
    "test:allure": "node scripts/clean-allure.mjs --full && node scripts/run-mobile-tests.mjs --reporter=line,allure-playwright",
    "test:report": "node scripts/clean-allure.mjs --full && node scripts/run-mobile-tests.mjs --reporter=line,html,allure-playwright",
    "allure:clean": "node scripts/clean-allure.mjs",
    "allure:clean:old": "node scripts/clean-allure.mjs",
    "allure:clean:full": "node scripts/clean-allure.mjs --full",
    "allure:prepare": "node scripts/prepare-allure.mjs",
    "allure:generate": "npm run allure:prepare && allure generate allure-results --clean -o allure-report",
    "allure:email": "npm run allure:generate && node scripts/send-allure-email.mjs",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "start": "npm test",
    "devices": "mobilewright devices",
    "inspect": "mobilewright inspect",
    "install:agent": "mobilewright install",
    "start:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:ANDROID_HOME='C:/Users/Abcom/AppData/Local/Android/Sdk'; $env:ANDROID_SDK_ROOT='C:/Users/Abcom/AppData/Local/Android/Sdk'; $emulator = Join-Path $env:LOCALAPPDATA 'Android\\Sdk\\emulator\\emulator.exe'; Start-Process -FilePath $emulator -ArgumentList '-avd','Pixel_10a','-camera-back','virtualscene','-camera-front','webcam0','-no-snapshot','-gpu','swiftshader_indirect','-no-boot-anim' -WindowStyle Normal\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@mobilewright/test": "^0.0.57",
    "@playwright/test": "1.51.1",
    "@types/node": "^26.5.0",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "archiver": "^8.0.0",
    "mobilewright": "^0.0.57",
    "nodemailer": "^10.0.10",
    "playwright": "1.51.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "playwright": "1.51.1",
    "@playwright/test": "1.51.1"
  }
}
